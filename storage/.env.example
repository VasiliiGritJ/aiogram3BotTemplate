# Local development only. Production uses process environment variables.
APP_ENV=development
DATABASE_PATH=db.db

# Telegram bot role
BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_PROXY_URL=
ADMIN_IDS=
SYSTEMD_SERVICE_NAME=
DEBUG_MODE=false

# Subscription runtime used by bot and webhook roles
PAYMENTS_MODE=test
PAYMENTS_TEST_MODE=true
SUBSCRIPTION_AMOUNT_MINOR=replace_with_approved_minor_units
SUBSCRIPTION_CURRENCY=RUB
YOOKASSA_RETURN_URL=https://example.invalid/payment-return
YOOKASSA_SHOP_ID=replace_with_test_shop_id
YOOKASSA_SECRET_TOKEN=replace_with_test_secret

# Separate local webhook role
PAYMENT_WEBHOOK_BIND_HOST=127.0.0.1
PAYMENT_WEBHOOK_BIND_PORT=8080
PAYMENT_WEBHOOK_PATH=/webhooks/yookassa/payment
