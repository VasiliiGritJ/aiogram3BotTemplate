# Local development only. Production uses process environment variables.
APP_ENV=development
DATABASE_PATH=db.db

# Telegram bot role
BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_PROXY_URL=
ADMIN_IDS=
SYSTEMD_SERVICE_NAME=
DEBUG_MODE=false

# Subscription runtime used by bot and webhook roles
PAYMENTS_MODE=test
PAYMENTS_TEST_MODE=true
PAYMENT_PROVIDER=yookassa
# The launch offer is fixed in server code: 499 RUB for 30 days, no auto-renew.
YOOKASSA_RETURN_URL=https://example.invalid/payment-return
YOOKASSA_SHOP_ID=replace_with_test_shop_id
YOOKASSA_SECRET_TOKEN=replace_with_test_secret

# PayAnyWay runtime (set PAYMENT_PROVIDER=payanyway for this provider).
PAYANYWAY_MNT_ID=replace_with_test_merchant_id
PAYANYWAY_INTEGRITY_CODE=replace_with_test_integrity_code
PAYANYWAY_SUCCESS_URL=https://example.invalid/payment/success
PAYANYWAY_FAIL_URL=https://example.invalid/payment/fail
PAYANYWAY_RETURN_URL=https://example.invalid/payment/return

# Required for a paid production launch. Keep placeholders in Git; use real
# public HTTPS pages and a support mailbox only in the production environment.
PUBLIC_SITE_URL=
TERMS_URL=
PRIVACY_URL=
REFUND_URL=
SUPPORT_EMAIL=

# Public commercial landing. These public values are mandatory before a
# production publication; no real seller data or bot URL belongs in Git.
SELLER_FULL_NAME=
SELLER_INN=
TELEGRAM_BOT_URL=

# NPD receipt delivery is a separate provider-neutral capability.
RECEIPTS_MODE=disabled
RECEIPT_PROVIDER=

# Separate local webhook role
PAYMENT_WEBHOOK_BIND_HOST=127.0.0.1
PAYMENT_WEBHOOK_BIND_PORT=8080
PAYMENT_WEBHOOK_PATH=/webhooks/yookassa/payment
PAYMENT_WEBHOOK_PUBLIC_URL=

# Website-first Prodamus checkout on the existing webhook role.
# Leave disabled until merchant/OIDC/NPD setup and authorized deployment pass.
# PAYMENT_PROVIDER / RECEIPT_PROVIDER retain the PayAnyWay fallback configuration;
# WEBSITE_PAYMENT_PROVIDER selects the separate website adapter, not an in-bot rail.
WEBSITE_PURCHASE_ENABLED=false
WEBSITE_PAYMENT_PROVIDER=prodamus
WEBSITE_PURCHASE_BASE_URL=
WEBSITE_PURCHASE_URL=
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
PRODAMUS_PAYFORM_URL=
PRODAMUS_SECRET_KEY=
PRODAMUS_SYSTEM_CODE=
# Local readiness assertion ONLY after Prodamus confirms merchant-side My Tax
# activation. Not a Prodamus request field and not proof of receipt delivery.
PRODAMUS_NPD_ENABLED=false
